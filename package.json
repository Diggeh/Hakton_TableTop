{
  "name": "hakton",
  "productName": "Hakton",
  "version": "0.1.0",
  "description": "Private native desktop VTT and voice comms for D&D 5e.",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:dir": "npm run build:renderer && electron-builder --dir",
    "test": "node --test --test-concurrency=1 test/networking/server.test.js test/networking/sessionManager.test.js test/networking/socketRouter.test.js test/chat/chat.test.js test/dice/formula.test.js test/dice/geometry.test.js test/dice/simulator.test.js test/dice/meshAndTray.test.js test/dice/routerUnit.test.js test/dice/socketSync.test.js",
    "test:dice": "node --test --test-concurrency=1 test/dice/formula.test.js test/dice/geometry.test.js test/dice/simulator.test.js test/dice/meshAndTray.test.js test/dice/routerUnit.test.js",
    "test:chat:storage": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test test/chat/storage.test.js",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cannon-es": "^0.20.0",
    "express": "^4.21.2",
    "peer": "^1.0.2",
    "socket.io": "^4.8.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "konva": "^9.3.18",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.hakton.app",
    "productName": "Hakton",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "backend/**",
      "database/**",
      "storage/**",
      "shared/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
